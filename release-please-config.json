{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Neue Funktionen"
    },
    {
      "type": "fix",
      "section": "Fehlerbehebungen"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Dokumentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Wartung",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "hud",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name === 'hud' || @.name === 'hud-domain' || @.name === 'hud-application' || @.name === 'hud-infrastructure' || @.name === 'hud-tui')].version"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
